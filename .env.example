# Copy to .env at repository root. Keep secrets out of git.
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
JWT_SECRET=replace-with-at-least-32-random-characters-before-deployment
CORS_ORIGINS=http://localhost:5173
STORAGE_DIR=./data/uploads
QDRANT_PATH=./data/qdrant
QDRANT_URL=
REDIS_URL=
MAX_UPLOAD_MB=30
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For Hindi/Telugu queries set EMBEDDING_PROVIDER=multilingual-e5 and reindex sources.
VECTOR_BACKEND=qdrant
LLM_PROVIDER=extractive
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
WHISPER_MODEL=medium
ENABLE_RERANKER=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_IMAGE_CAPTION=false
ENABLE_CLIP=false
OCR_LANG=eng
OCR_ENGINE=tesseract
PDF_TABLE_ENGINE=pdfplumber
UNSTRUCTURED_FALLBACK=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
